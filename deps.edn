{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; Unlike `cloud-itonami-isic-4920` (which wraps a pre-existing bespoke
 ;; capability library `kotoba-lang/logistics`), this automotive-fuel-
 ;; retail vertical is SELF-CONTAINED: there is no `kotoba-lang/forecourt`
 ;; to delegate forecourt-safety validation to, so the meter-certainty /
 ;; price-band / overfill / vapor-recovery range checks live as pure
 ;; functions in `forecourt.registry` rather than wrapping an external lib.
 ;; This repo is standalone (forkable outside the workspace); the
 ;; :local/root paths only resolve inside the monorepo checkout -- a
 ;; standalone fork should override them with git coordinates.
 :deps {;; デジタル庁デザインシステム(DADS) -- this workspace's BASE design
        ;; system. `jp-go-dds.skin/dds+skin` styles the build-time
        ;; operator console (`forecourt.render-html`) without touching
        ;; its markup. Git coordinates, not :local/root: this dep must
        ;; resolve from a standalone fork too.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        ;; shared langchain.db store seam (EDN-blob codec + identity
        ;; schema + event-log read/append helpers) that ~190
        ;; cloud-itonami actors used to hand-roll (ADR-2607141600);
        ;; forecourt.store's DatomicStore uses it instead of its own
        ;; enc/dec* two-liner.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "forecourt.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by RUNNING the real actor
  ;; (flagship checklist item 2). Refuses to write a page whose ledger
  ;; contains zero :governor-hold facts.
  :render-html {:main-opts ["-m" "forecourt.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
